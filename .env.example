# Template for the environment variables this app needs.
#
# Local dev:  copy this file to ".env.local" and fill in real values.
# Vercel:     add the same keys under Project → Settings → Environment Variables.
#
# ── Database (PostgreSQL) — the live data store ──
# The app is server-authoritative: all reads/writes go through the /api/* route
# handlers into lib/db.ts. Server-side only; never exposed to the browser.
#
# Local Postgres example (database must exist — `CREATE DATABASE uft_crm;`):
#   DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/uft_crm
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/uft_crm

# PERSISTENT baseline database (create with: CREATE DATABASE uft_crm_persistent;).
# "Reset" restores this into the working DB; Dev Tools can also push working → here.
# Optional — if unset, the reset/sync actions are disabled.
PERSISTENT_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/uft_crm_persistent

# ── Layer seams (UI → Seam A → Core → Seam B → Postgres) ──
# Seam B is the internal Data API (app/api/internal/v1/data/**). The core layer
# talks to Postgres THROUGH it, so the data service can later be a separate
# deployable — just point DATA_API_URL at the remote host.
#   DATA_API_URL     base origin of the Data API (default http://localhost:3000)
#   INTERNAL_API_KEY shared secret required by the Data API (x-internal-key header).
#                    Leave blank for open local dev; set it to lock the seam down.
#   DATA_TRANSPORT   "http" (default — real HTTP seam) | "inprocess" (talk to pg
#                    directly, skipping HTTP; faster for a single-process run).
DATA_API_URL=http://localhost:3000
INTERNAL_API_KEY=
# DATA_TRANSPORT=http

# ── Running the frontend as its own tier ──
# The browser's API calls default to same-origin ("/api/*"). To run the UI as a
# separate process from the middleware+backend server, point this at that
# server's origin; every client call is rewritten to it (CORS is handled by
# middleware.ts). Used by `npm run dev:frontend` / `start:frontend`.
#   Server (middleware+backend):  npm run dev:server     → http://localhost:4000
#   Frontend (UI):                npm run dev:frontend   → http://localhost:3000
# NEXT_PUBLIC_API_BASE is a build/start-time value (baked into the browser bundle).
NEXT_PUBLIC_API_BASE=

# ── JSONBin.io (legacy) — migration source only ──
# The app no longer uses JSONBin at runtime. These are needed ONLY if you run the
# one-time import (scripts/migrate-jsonbin-to-pg.mjs) to pull old data into
# Postgres. In .env.local escape each "$" in the key as "\$".
JSONBIN_BIN_ID=your-bin-id
JSONBIN_ACCESS_KEY=your-access-key

# ── Email (Resend) — powers the "Send Email" action on leads ──
# Get an API key at https://resend.com (free tier available). Server-side only;
# never exposed to the browser.
#
# RESEND_FROM_EMAIL must use a domain you've verified in Resend, e.g.
#   "UFT <hello@yourdomain.com>".
# For quick testing without a verified domain, Resend allows
#   "onboarding@resend.dev" (the default below) — but it can only send to the
#   email address that owns the Resend account.
# (EMAIL_FROM is also accepted as an alias for RESEND_FROM_EMAIL.)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=UFT CRM <onboarding@resend.dev>

# Absolute base URL used to build Accept/Decline links inside meeting-invite
# emails. Optional — if unset, it's derived from the request host (fine for
# local dev and Vercel). Set it explicitly if links must point to a fixed
# public domain, e.g. https://crm.uftech.in
APP_BASE_URL=

# ── Lead enrichment providers — powers the "Enrich" action on leads ──
# Add ANY subset. The enrichment route runs whichever keys are present and
# merges the results (company profile + a de-duplicated point-of-contact list).
# All server-side only; never exposed to the browser.
#
#   APOLLO_API_KEY  — Apollo.io. Best for finding the hiring/HR contact by title
#                     plus a company profile. Get it: Settings → Integrations → API.
#   HUNTER_API_KEY  — Hunter.io. Finds emails by company DOMAIN. Get it: API tab.
#   PDL_API_KEY     — People Data Labs. Company + person data. Get it: Dashboard → API Keys.
APOLLO_API_KEY=
HUNTER_API_KEY=
PDL_API_KEY=

# ── Job postings — powers the Quick Tab "Job Postings" panel ──
#   SERPAPI_KEY — SerpAPI (Google Jobs engine). One key, free tier ~100/mo.
#                 Get it: https://serpapi.com → Dashboard → Your API Key.
# Server-side only. Without it, Quick Tab still shows company + contacts; the
# jobs panel just prompts to add this key.
SERPAPI_KEY=

# ── AI (Google Gemini, via Google AI Studio) — powers the lead "AI Summary" ──
#   GEMINI_API_KEY — get one at https://aistudio.google.com/apikey. Server-side
#                    only; never exposed to the browser. Without it the AI summary
#                    button reports that AI is not configured.
#   GEMINI_MODEL   — optional model override (default: gemini-flash-lite-latest).
# The active AI provider/model is chosen in the Admin Panel (Director only). It
# can use a key entered there, or fall back to these env vars per provider:
#   GEMINI_API_KEY     — Google Gemini
#   OPENAI_API_KEY     — OpenAI-compatible (also set a base URL in the panel)
#   ANTHROPIC_API_KEY  — Anthropic (Claude)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Naukri scout verification (Feature 7) ──
# The scout queue works fully in-app with no config. OPTIONALLY bridge to the
# uftech.in talent-acquisition module:
#   SCOUT_WEBHOOK_URL — if set, each verification request is POSTed here. The
#                       payload includes a `callback_url` pointing at this app's
#                       /api/naukri-callback, which the TA module calls back with
#                       { request_id, status: "found"|"not_found", naukri_url?, note? }
#                       to record the verdict (also updates the lead's profile).
SCOUT_WEBHOOK_URL=
